# ─────────────────────────────────────────────────────────────
# Kambis Executive Report Dashboard — แม่แบบของไฟล์ .env
#
# คัดลอกเป็น .env แล้วใส่ค่าจริง ไฟล์ .env ถูก gitignore ไว้แล้ว
# ค่าที่ตั้งใน shell ชนะค่าในไฟล์นี้เสมอ (env.js เขียนทับเฉพาะตัวที่ยังไม่มีค่า)
#
# **ห้าม scp ไฟล์ .env ของเครื่องพัฒนาขึ้นเซิร์ฟเวอร์ทั้งอัน** ให้เขียนใหม่ที่ปลายทาง
# เพราะ ALLOW_NO_AUTH กับ DEV_LOGIN ที่ค้างอยู่คือทางเดียวที่ทำให้ระบบหลุดสู่สาธารณะ
# ขั้นตอน deploy เต็ม: deploy/README.md
# ─────────────────────────────────────────────────────────────

# ── ผู้ช่วย AI ────────────────────────────────────────────────
# คีย์ขอได้ที่ https://aistudio.google.com/apikey
# ไม่ตั้ง = ปิดแชท (ส่วนอื่นของ Dashboard ยังทำงานปกติ ไม่ได้ใช้ AI เลย)
# ใช้ชื่อ GEMINI_API_KEY แทนก็ได้
GOOGLE_API_KEY=

# โควตาคำถามต่อคนต่อวัน — นับเฉพาะที่เรียกสำเร็จ รีเซ็ตตามวันแบบ UTC
CHAT_QUOTA_PER_DAY=50

# ── ล็อกอิน ──────────────────────────────────────────────────
# อายุ session หลังล็อกอิน (ชั่วโมง)
SESSION_HOURS=12

# ── เครือข่าย ────────────────────────────────────────────────
# บนเครื่องตัวเองไม่ต้องตั้งสองตัวนี้ ค่าเริ่มต้นคือ 127.0.0.1:5173
# ใน Docker ถูกตรึงไว้ที่ docker-compose.yml แล้ว (ตั้งที่นี่ไม่มีผล)
# PORT=5173
# HOST=127.0.0.1

# ตั้งเป็น 1 **เฉพาะเมื่อมี nginx/Caddy คั่นอยู่หน้าจริง ๆ**
# ขาดไม่ได้เมื่อมี proxy — ไม่งั้น clientIp() เห็นเป็น IP ของ proxy ทุกคน
# แล้วคนเดียวพิมพ์รหัสผิด 5 ครั้งจะล็อกทุกคนออกจากระบบ 15 นาที
# แต่ถ้าตั้งเป็น 1 ทั้งที่ไม่มี proxy ใครก็ปลอม X-Forwarded-For เพื่อหนีการล็อกได้
TRUST_PROXY=0

# ── การดึงข้อมูล ─────────────────────────────────────────────
# คูลดาวน์ปุ่ม "รีเฟรชข้อมูล" ใช้ร่วมกันทุกคน (วินาที)
# กันไม่ให้ยิงคำขอไป Google Sheets ถี่เกินจนโดน 429 — กดก่อนครบเวลายังได้ชุดล่าสุดกลับไป
# ห้ามตั้งเกิน 300 (อายุ cache ในหน่วยความจำ) ไม่งั้นคูลดาวน์จะไม่มีความหมาย
REFRESH_COOLDOWN_SEC=120

# ตั้งเป็น gviz เพื่อกลับไปใช้ endpoint เดิมชั่วคราวเวลาต้องเทียบผล
# **อย่าเปิดค้างไว้** — gviz เดาเองว่าแถวบน ๆ เป็นหัวตารางแล้วตัดทิ้ง จำนวนแถวที่ตัด
# ไม่เท่ากันในแต่ละแท็บ ทำให้ราคาที่กรอกไว้ที่ H2 หายทั้งชีตโดยไม่มี error (ดู CLAUDE.md §1)
# CSV_ENDPOINT=gviz

# ─────────────────────────────────────────────────────────────
# สองตัวล่างนี้ปิดระบบความปลอดภัย — ห้ามมีอยู่ในไฟล์ .env ของเซิร์ฟเวอร์จริง
# ─────────────────────────────────────────────────────────────

# โหมดทดสอบ: พิมพ์ชื่อผู้ใช้/รหัสอะไรก็เข้าได้ เท่ากับไม่มีระบบล็อกอินเลย
# เซิร์ฟเวอร์จะไม่ยอมสตาร์ทถ้าเจอคู่กับ HOST ที่ไม่ใช่ localhost
# DEV_LOGIN=1

# ยอมให้เปิดสู่เครือข่ายทั้งที่ยังไม่มีบัญชีผู้ใช้เลยสักคน
# = เปิดยอดขาย ต้นทุน และรายชื่อลูกค้าให้ทุกคนที่เข้าถึงพอร์ตได้ โดยไม่มีอะไรกั้น
# ทางที่ถูกคือสร้างบัญชีก่อน: node scripts/manage-users.js add <ชื่อ> --name "ชื่อจริง" --role exec
# ALLOW_NO_AUTH=1

# ─────────────────────────────────────────────────────────────
# ไม่ใช่ค่าของเซิร์ฟเวอร์ แต่ใช้ตอนตั้งรหัสผ่านแบบอัตโนมัติในสคริปต์ deploy:
#   KAMBIS_PASSWORD=... node scripts/manage-users.js add <ชื่อ> --name "ชื่อจริง" --role exec
# ปกติปล่อยให้ถามตอนรันดีกว่า (ขึ้นเป็น * และไม่ตกใน shell history)
# ─────────────────────────────────────────────────────────────
